# Copy to backend/.env and adjust. All values have working defaults, so this
# file is only needed to point at non-local services.

VERISHIELD_DEBUG=true

# 27018 avoids clashing with a native MongoDB on the default port.
VERISHIELD_MONGO_URL=mongodb://localhost:27018
VERISHIELD_MONGO_DB=verishield
VERISHIELD_REDIS_URL=redis://localhost:6379/0
VERISHIELD_QDRANT_URL=http://localhost:6333

VERISHIELD_MINIO_ENDPOINT=localhost:9000
VERISHIELD_MINIO_ACCESS_KEY=verishield
VERISHIELD_MINIO_SECRET_KEY=verishield-dev-secret

# Set false to force CPU inference.
VERISHIELD_USE_GPU=true

VERISHIELD_RISK_MEDIUM_THRESHOLD=30
VERISHIELD_RISK_HIGH_THRESHOLD=65
