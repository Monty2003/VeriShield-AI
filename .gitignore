.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
backend/data/uploads/*
!backend/data/uploads/.gitkeep
node_modules/
dist/
.DS_Store
*.onnx
*.engine
models/

# --- Datasets -------------------------------------------------------------
# Real identity documents must NEVER be committed. This is intentionally
# broad: a leaked Aadhaar or passport scan cannot be un-published, and git
# history keeps it even after deletion.
backend/data/datasets/raw/**
backend/data/datasets/generated/**
backend/data/datasets/external/**
!backend/data/datasets/**/.gitkeep
!backend/data/datasets/**/README.md
backend/data/samples/synthetic/

# --- Frontend -------------------------------------------------------------
# .env alone matches only a file named exactly that, so the local override
# CRA reads has to be listed by name. The committed .env.development and
# .env.production hold no secrets and stay in the repo.
.env.local
.env.*.local
frontend/build/
